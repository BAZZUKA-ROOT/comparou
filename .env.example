# Copy to .env.local and fill in. NEVER commit the real .env.local.

# Optional: Mercado Livre OAuth token (free to create at developers.mercadolivre.com.br).
# Without it, ML search may return 403 and the app just skips ML.
ML_ACCESS_TOKEN=

# Price-drop alert e-mail (the daily job sends here). Leave blank for dry-run (logs only).
ALERT_EMAIL=

# SMTP for sending alerts (e.g. Gmail app password, or any provider).
# If any of these is blank, the job logs the alert instead of e-mailing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where to store the watchlist JSON (defaults to ./data)
COMPAROU_DATA=
